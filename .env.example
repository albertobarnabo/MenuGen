# ── Image provider API keys ────────────────────────────────────────────────────
# Set at least one. MenuGen calls each vendor's own API directly; keys never
# leave the server. Leave a key empty to hide that provider's models in the UI.

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini API — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Black Forest Labs (FLUX) — https://dashboard.bfl.ai
BFL_API_KEY=

# ── Optional settings ──────────────────────────────────────────────────────────
# Where jobs, generated images and ZIPs are stored (default: ./data)
# MENUGEN_DATA_DIR=./data

# Safety cap on rows per batch (default: 500)
# MENUGEN_MAX_ITEMS_PER_JOB=500

# Pre-select a model in the UI/CLI (see `npm run cli -- models` for ids)
# MENUGEN_DEFAULT_MODEL=openai/gpt-image-1-mini

# Show the free "Mock (sample photos)" model in the UI even when real keys are set.
# It is always shown when no provider is configured, so you can try the UI first.
# MENUGEN_ENABLE_MOCK=true

# Vendor base URL overrides (proxies / regional endpoints). Rarely needed.
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# BFL_BASE_URL=https://api.bfl.ai
